# Render Hybrid Cache Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# DO NOT commit real API keys, credentials, or secrets to version control.

# Tier 2 Distributed Redis Cache Connection URL (Optional)
REDIS_URL=redis://localhost:6379/0

# Firebase Admin SDK Service Account JSON Key File Path (Required for live Firebase BaaS test drive)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Server Port (for FastAPI / Uvicorn SSR Demo)
PORT=8000
